# Clé secrète JWT — à changer obligatoirement en production
JWT_SECRET=changez-cette-cle-secrete-en-production

# Base de données Turso (libSQL)
TURSO_DATABASE_URL=libsql://votre-base.turso.io
TURSO_AUTH_TOKEN=votre-token-turso

# Port du serveur (optionnel, défaut: 3000)
PORT=3000

# Environnement
NODE_ENV=production
